rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTORIZACIÓN — SIN CAMBIOS respecto a lo desplegado hoy. Estas
    // funciones y las reglas de /vehicles ya están en producción y
    // app.js ya las cumple: no se tocan (Fase 2, requisito explícito
    // de conservar TODAS las reglas actuales de vehicles).
    // ============================================================
    function signedIn() {
      return request.auth != null;
    }

    // Paso 2 — Restauración del panel de administración: whitelist de
    // correos autorizados a auto-promoverse a admin. Esta es la MISMA
    // lista que auth.js usa del lado del cliente, pero AQUÍ es donde
    // realmente se decide — el cliente solo puede "pedir" convertirse
    // en admin (ver allow update de /users más abajo); Firestore es
    // quien concede o rechaza, comparando contra el email YA VERIFICADO
    // y anclado en el documento (resource.data.email, nunca el que
    // venga en la petición). Si alguien manipula auth.js o llama a
    // Firestore directo desde la consola, esta lista sigue siendo la
    // única fuente de la verdad — no el frontend.
    function isWhitelistedAdminEmail(email) {
      return email in [
        'manuel15160410@gmail.com',
        'jose.10.manuel@hotmail.com'
      ];
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isActive() {
      return userExists()
        && userDoc().data.status == "active";
    }

    function isAdmin() {
      return isActive()
        && userDoc().data.role == "admin";
    }

    function isEditor() {
      return isActive()
        && userDoc().data.role == "editor";
    }

    function canManageVehicles() {
      return isAdmin() || isEditor();
    }

    // ==========================================================
    // VALIDACIONES — VEHÍCULOS (sin cambios respecto a lo desplegado)
    // ==========================================================

    function datosValidos() {
      let d = request.resource.data;

      return
        d.keys().hasAll([
          'name',
          'price',
          'category',
          'condition',
          'brand',
          'year',
          'carfax'
        ])

        && d.name is string
        && d.name.size() > 0
        && d.name.size() < 150

        && d.price is number
        && d.price > 0
        // Tope subido de 20.000.000 a 2.000.000.000 RD$. El anterior era
        // un límite real de publicación, no una defensa.
        //
        // ⚠️ Este comentario describía una conversión que YA NO EXISTE. Decía
        // que `price` se obtiene convirtiendo el importe en USD con
        // `USD_TO_RD_RATE`; esa constante se retiró junto con la conversión a
        // pesos (ver "Moneda: no se convierte NADA" en README.md). Hoy
        // app.js calcula `price` multiplicando por `USD_INDEX_FACTOR`, y el
        // resultado NO es un precio: es un índice interno que existe solo
        // porque este esquema cerrado exige el campo y porque es el único eje
        // numérico común entre monedas. No se muestra, no se imprime y no se
        // envía a nadie. El tope sigue teniendo sentido como descarte de
        // valores absurdos o corruptos, que es lo único que hace.
        // Se mantiene un techo para seguir descartando valores absurdos o
        // corruptos; el resto de restricciones no cambia. El formulario
        // valida el mismo tope (MAX_PRICE_RD en app.js) para que el
        // rechazo llegue como mensaje y no como fallo mudo al guardar.
        && d.price < 2000000000

        // Lista CERRADA de categorías. Tiene que contener TODO valor que
        // el sitio pueda escribir, o la publicación se rechaza entera con
        // permission-denied y el formulario solo puede decir "Error al
        // guardar". Debe mantenerse sincronizada con CATEGORIES de
        // vehiculo-taxonomia.js (app.js, el <select> y las secciones de
        // index.html salen todos de ahí).
        //
        // Los tres primeros valores son los del esquema anterior. 'suvs' y
        // 'pickups' ya NO se ofrecen al publicar —las dos se muestran
        // fusionadas como "Jeepetas / Camionetas"— pero siguen aceptados a
        // propósito: son los que llevan los vehículos ya publicados, y
        // quitarlos de aquí haría que cualquier intento de guardar uno de
        // esos documentos fuese rechazado. No se migra ningún documento:
        // el valor guardado se traduce al leer.
        && d.category in [
          'sedanes',
          'suvs',
          'pickups',
          'jeepetas_camionetas',
          'minivan',
          'vehiculos_pesados'
        ]

        && d.condition in [
          'nuevo',
          'usado',
          'importado'
        ]

        && d.brand is string
        && d.brand.size() > 0
        && d.brand.size() < 50

        && d.year is string
        && d.year.matches('^[0-9]{4}$')

        && d.carfax in ['si', 'no'];
    }

    function camposOpcionalesValidos() {

      let d = request.resource.data;

      return

        (!('mileage' in d)
          || (d.mileage is string && d.mileage.size() < 30))

        && (!('color' in d)
          || (d.color is string && d.color.size() < 40))

        && (!('transmission' in d)
          || (d.transmission in [
              'Automático',
              'Mecánica',
              'Manual',
              ''
          ]))

        && (!('currency' in d)
          || (d.currency in ['RD','USD']))

        && (!('priceUSD' in d)
          || (
              d.priceUSD == null
              || (
                d.priceUSD is number
                && d.priceUSD > 0
                && d.priceUSD < 20000000
              )
          ))

        // ⚠️ `null` ADMITIDO (auditoría final). app.js (readPublishForm)
        // calcula priceDisplay y priceUSD en la MISMA expresión:
        //     const priceDisplay = currency === 'USD' ? `USD$ ...` : null;
        //     const priceUSD     = currency === 'USD' ? priceRaw   : null;
        // priceUSD ya contemplaba el null; priceDisplay no. Como RD$ es la
        // moneda por defecto del formulario, TODA publicación en pesos
        // mandaba priceDisplay: null y Firestore la rechazaba con
        // permission-denied: el vehículo no se publicaba y el admin solo
        // veía "❌ Error al guardar en Firebase". Reproducido contra el
        // emulador con el payload literal del formulario.
        && (!('priceDisplay' in d)
          || (
              d.priceDisplay == null
              || (
                d.priceDisplay is string
                && d.priceDisplay.size() < 100
              )
          ))

        && (!('features' in d)
          || (
              d.features is list
              && d.features.size() <= 30
          ))

        && (!('seoTags' in d)
          || (
              d.seoTags is list
              && d.seoTags.size() <= 20
          ))

        && (!('media' in d)
          || (
              d.media is list
              && d.media.size() <= 10
          ))

        && (!('tags' in d)
          || (
              d.tags is map
              && d.tags.size() <= 30
          ))

        && (!('slug' in d)
          || (
              d.slug is string
              && d.slug.size() < 150
              && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          ))

        && (!('img' in d)
          || (
              d.img is string
              && d.img.size() < 500
          ))

        && (!('createdAt' in d)
          || (
              d.createdAt is number
              && d.createdAt > 0
          ));
    }

    function soloCamposPermitidos() {

      let d = request.resource.data;

      return d.keys().hasOnly([

        'name',
        'price',
        'priceUSD',
        'currency',
        'priceDisplay',

        'category',
        'condition',
        'brand',
        'year',
        'carfax',

        'mileage',
        'color',
        'transmission',

        'features',
        'seoTags',
        'media',

        'tags',
        'slug',
        'img',

        'createdAt'
      ]);
    }

    // ⚠️ REGRESIÓN CRÍTICA CORREGIDA (auditoría final).
    //
    // La versión anterior era:
    //     request.method != 'update'
    //       || request.resource.data.createdAt == resource.data.createdAt;
    //
    // En Firestore Rules, leer una clave que NO existe en un mapa no
    // devuelve null: lanza un error de evaluación, y la regla entera pasa a
    // denegar. NINGUNO de los 37 vehículos que hay hoy en producción tiene
    // el campo `createdAt` (solo lo escriben las publicaciones nuevas), así
    // que `resource.data.createdAt` reventaba en CADA edición.
    //
    // Efecto real, reproducido contra el emulador con los 37 documentos
    // descargados de producción: 37/37 ediciones denegadas y 37/37
    // backfills de slug denegados. Desde el despliegue de estas reglas, el
    // administrador no podía guardar NINGÚN cambio en NINGÚN vehículo del
    // inventario: solo veía "Error al guardar en Firebase".
    //
    // La garantía que se buscaba se conserva íntegra —una fecha de alta ya
    // establecida NUNCA puede reescribirse ni borrarse— pero ahora se
    // contempla el caso de que aún no exista, permitiendo fijarla una vez.
    // El tipo y el rango de `createdAt` los sigue validando
    // camposOpcionalesValidos() (número > 0).
    function createdAtInmutable() {
      return request.method != 'update'
        || (
          ('createdAt' in resource.data)
            // Ya existe: debe seguir presente y con el MISMO valor.
            ? ('createdAt' in request.resource.data
                && request.resource.data.createdAt == resource.data.createdAt)
            // Nunca se fijó (documento heredado): puede quedarse sin fecha
            // o establecerse por primera vez, nunca reescribirse después.
            : true
        );
    }

    // ==========================================================
    // VEHÍCULOS — SIN CAMBIOS (idéntico a lo desplegado hoy)
    // ==========================================================

    match /vehicles/{vehicleId} {

      allow read: if true;

      allow create:
        if canManageVehicles()
        && datosValidos()
        && camposOpcionalesValidos()
        && soloCamposPermitidos();

      allow update:
        if canManageVehicles()
        && datosValidos()
        && camposOpcionalesValidos()
        && soloCamposPermitidos()
        && createdAtInmutable();

      allow delete:
        if canManageVehicles();
    }

    // ==========================================================
    // PERFILES — CORREGIDO (Fase 2). El bloque anterior tenía
    // `allow write: if false`, que bloqueaba TODA escritura, incluida
    // la auto-creación del perfil que auth.js hace en cada registro
    // (email/password Y Google). Resultado real: cualquier intento de
    // registro fallaba con permission-denied desde el día del deploy
    // de esa versión. Este bloque restaura la escritura, pero con
    // las mismas restricciones de seguridad que ya existían en el
    // diseño original de auth.js/roles.js:
    //   - el usuario SOLO puede crear su propio documento (uid propio)
    //   - SOLO puede nacer como role:customer + status:active
    //   - NUNCA puede escalar su propio role/status/createdAt/schemaVersion
    //   - un admin puede gestionar cualquier perfil, con listas cerradas
    // ==========================================================

    // Validaciones de integridad del propio perfil (no de autorización).
    // provider/photoURL son opcionales — auth.js los escribe siempre
    // (Google e email/password), pero se validan como opcionales para
    // no romper documentos ya existentes que no los tengan.
    function validUserProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.schemaVersion is int && data.schemaVersion >= 1
        && (!('provider' in data) || data.provider in ['password', 'google.com'])
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 600))
        && (!('lastLogin' in data) || data.lastLogin is timestamp)
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100))
        && (!('username' in data) || (data.username is string && data.username.size() <= 30))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('country' in data) || (data.country is string && data.country.size() <= 100));
    }

    match /users/{uid} {
      // Lectura: el propio usuario, o un admin gestionando usuarios.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Auto-registro: el propio usuario crea SU documento. Solo puede
      // nacer como 'customer' + 'active' — escalar a sales/editor/admin
      // exige que un admin lo haga después, nunca en la creación.
      // createdAt debe escribirse con FieldValue.serverTimestamp() en
      // el cliente (auth.js lo hace), nunca con Date.now().
      // ⚠️ ESCALADA DE PRIVILEGIOS CERRADA (auditoría final).
      // Antes, `email` solo se validaba como "cadena de hasta 254
      // caracteres": nada lo ataba al correo REALMENTE autenticado. Como
      // isWhitelistedAdminEmail() consulta resource.data.email —el valor
      // guardado, que lo escribe el propio usuario—, cualquiera podía
      // registrarse con su correo, crear su documento declarando
      // 'manuel15160410@gmail.com', auto-promoverse a admin y quedarse con
      // el control del inventario y de todos los usuarios. Reproducido de
      // extremo a extremo contra el emulador antes de este cambio.
      //
      // El correo del documento debe coincidir con el del token de Firebase
      // Auth. No rompe nada: auth.js siempre escribe `email: user.email`,
      // que es exactamente ese valor (tanto en registro por contraseña como
      // con Google).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','name','role','status','createdAt','schemaVersion','provider','photoURL','lastLogin','lastName','username','city','phone','address','country'])
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && validUserProfile(request.resource.data);

      // El propio usuario edita su perfil, pero NUNCA role/status/
      // createdAt/schemaVersion/email — deben permanecer EXACTAMENTE
      // iguales. email se ancla aquí porque NINGÚN flujo legítimo lo
      // reescribe tras la creación (verificado: ni loginUser(), ni
      // loginWithGoogle(), ni updateUserProfile() lo tocan jamás) — así
      // que bloquearlo no rompe nada y cierra una vía de manipulación
      // directa vía consola del navegador (Auditoría 4).
      // provider NO se ancla a propósito: loginWithGoogle() SÍ necesita
      // reescribirlo de forma legítima (línea ~320 de auth.js) cuando
      // el proveedor detectado cambia. No es un riesgo de privilegios:
      // ninguna función de autorización (isAdmin/isEditor/canManage*)
      // lee 'provider' — solo role/status, que sí están anclados.
      // (photoURL SÍ puede cambiar: lo actualiza loginWithGoogle() en
      // cada login si Google trae una foto nueva, y ahora también el
      // propio usuario desde su perfil.)
      // role: caso normal, no cambia. ÚNICA excepción (Paso 2): el
      // propio usuario puede ponerse role:'admin' a sí mismo — pero
      // SOLO si su email (resource.data.email, el ya verificado y
      // anclado, nunca el de la petición) está en la whitelist server-
      // side de arriba. Cualquier otro cambio de role (a 'editor',
      // 'sales', o 'admin' sin estar en la whitelist) sigue denegado
      // exactamente igual que antes.
      allow update: if signedIn() && request.auth.uid == uid
        && (
          request.resource.data.role == resource.data.role
          // La promoción exige, además de estar en la whitelist, que el
          // correo guardado sea el del token. Sin esta segunda condición,
          // cualquier documento con el email falsificado que ya existiera
          // de antes seguiría sirviendo para escalar.
          // ⚠️ A-2 (auditoría de release): faltaba exigir el correo
          // VERIFICADO. Firebase Auth NO comprueba la propiedad del buzón
          // al registrarse con correo y contraseña, así que la whitelist
          // por sí sola no demuestra nada: bastaba con crear una cuenta
          // declarando una de las direcciones autorizadas para obtener el
          // rol admin y, con él, el control del inventario y de todos los
          // perfiles. Reproducido contra el emulador: con
          // email_verified=false la promoción se ACEPTABA.
          // `email_verified` lo emite Firebase Auth dentro del token y el
          // cliente no puede falsificarlo. Ninguna otra condición se
          // relaja: siguen exigiéndose la whitelist del servidor y que el
          // correo guardado coincida con el del token.
          || (
            request.resource.data.role == 'admin'
            && isWhitelistedAdminEmail(resource.data.email)
            && resource.data.email == request.auth.token.email
            && request.auth.token.email_verified == true
          )
        )
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['email','name','role','status','createdAt','schemaVersion','provider','photoURL','lastLogin','lastName','username','city','phone','address','country'])
        && validUserProfile(request.resource.data);

      // Un admin puede cambiar cualquier cosa de cualquier perfil, con
      // listas cerradas para role/status y perfil siempre válido.
      //
      // `delete` va SEPARADO a propósito: al borrar, request.resource es
      // null, así que validUserProfile(request.resource.data) fallaba con
      // error y la regla denegaba SIEMPRE. Era una regla muerta —un admin
      // no podía borrar ningún perfil— comprobado contra el emulador.
      //
      // Se añade además hasOnly(): la rama de admin era la única sin lista
      // cerrada de campos, así que permitía inyectar claves arbitrarias en
      // el perfil de cualquier usuario. Es la misma lista que ya usan las
      // ramas de creación y de auto-edición.
      //
      // ⚠️ S-3: email, createdAt y schemaVersion quedan ANCLADOS también
      // aquí. Las otras dos ramas (creación y auto-edición) ya los fijaban;
      // esta era la única que permitía reescribirlos. No es una escalada
      // —un admin ya gobierna roles y estados— pero sí la última vía por la
      // que la identidad del perfil podía cambiar en silencio: `email` es lo
      // que consulta isWhitelistedAdminEmail(), y `createdAt` es la fecha de
      // alta que el resto del archivo defiende como inmutable. Un fallo del
      // panel que enviara el documento entero los habría sobrescrito sin que
      // nada lo impidiera.
      //
      // Se usa el MISMO patrón defensivo que createdAtInmutable(): se
      // compara solo si el campo ya existe en el documento. Anclarlo a secas
      // repetiría el defecto C-1 —leer una clave ausente no devuelve null en
      // Rules, lanza un error de evaluación y la regla entera pasa a
      // denegar—, lo que dejaría a un admin sin poder tocar jamás un perfil
      // heredado al que le faltara alguno de los tres. Así, el campo puede
      // fijarse una vez si nunca existió, y nunca reescribirse después.
      //
      // Verificado contra las 114 pruebas existentes: ninguna hace que un
      // admin modifique estos tres campos, y las que lo editan por otros
      // motivos usan updateDoc() parcial, donde request.resource.data es el
      // documento resultante y los valores no tocados coinciden consigo
      // mismos.
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email','name','role','status','createdAt','schemaVersion','provider','photoURL','lastLogin','lastName','username','city','phone','address','country'])
        && validUserProfile(request.resource.data)
        && (('email' in resource.data)
              ? request.resource.data.email == resource.data.email : true)
        && (('createdAt' in resource.data)
              ? request.resource.data.createdAt == resource.data.createdAt : true)
        && (('schemaVersion' in resource.data)
              ? request.resource.data.schemaVersion == resource.data.schemaVersion : true)
        && (!('role' in request.resource.data) || request.resource.data.role in ['customer','sales','editor','admin'])
        && (!('status' in request.resource.data) || request.resource.data.status in ['active','disabled','pending']);

      allow delete: if isAdmin();
    }

    // ==========================================================
    // SUBCOLECCIONES DEL USUARIO — favoritos, historial, cotizaciones
    // y preferencias. Todas siguen el mismo patrón: SOLO el propio
    // usuario puede leer/escribir su subcolección — ni siquiera un
    // admin puede leerlas (no son datos de gestión, son datos
    // personales del cliente). uid en la ruta ya es la autorización;
    // no hace falta canManageUsers()/isAdmin() aquí.
    // ==========================================================

    // Favoritos: users/{uid}/favorites/{vehicleId} — el ID del vehículo
    // como ID del documento evita duplicados por diseño (upsert natural).
    // ⚠️ LECTURA ARREGLADA (auditoría final). `allow read, write` metía la
    // lectura bajo una condición que desreferencia request.resource.data;
    // en una lectura request.resource es null, así que la expresión daba
    // error y Firestore DENEGABA. Resultado real: el usuario no podía leer
    // sus propios favoritos —la pestaña Favoritos del Dashboard quedaba
    // vacía y no había sincronización entre dispositivos, aunque en local
    // pareciera funcionar por el respaldo de localStorage—. Comprobado
    // contra el emulador antes de este cambio (get y list denegados).
    // La escritura no cambia: mismas restricciones de siempre.
    match /users/{uid}/favorites/{vehicleId} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['addedAt'])
        && request.resource.data.addedAt is timestamp;

      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Historial de vehículos vistos: users/{uid}/history/{autoId}.
    match /users/{uid}/history/{entryId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['vehicleId', 'viewedAt'])
        && request.resource.data.vehicleId is string
        && request.resource.data.viewedAt is timestamp;
      // El historial no se edita, solo se crea o se borra.
      allow update: if false;
    }

    // Cotizaciones guardadas desde la calculadora: users/{uid}/quotes/{autoId}.
    //
    // Los cinco campos del bloque de datos financieros (vehiclePrice,
    // downPaymentPct, institution, annualRate, vehicleType) se añadieron
    // para poder REGENERAR el PDF de la cotización desde el dashboard:
    // sin ellos el documento no puede indicar institución, tasa ni monto
    // financiado. Son OPCIONALES a propósito — las cotizaciones creadas
    // antes de este cambio no los tienen y deben seguir siendo legibles,
    // y una futura versión del cliente que deje de enviarlos tampoco
    // debe romperse. Cuando vienen, se validan con el mismo rigor que
    // los originales: tipo correcto y rango acotado, para que nadie
    // pueda inflar el documento con datos arbitrarios.
    match /users/{uid}/quotes/{quoteId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'vehicleId', 'vehicleName', 'downPayment', 'termMonths', 'monthlyPayment', 'createdAt',
          'vehiclePrice', 'downPaymentPct', 'institution', 'annualRate', 'vehicleType'
        ])
        && request.resource.data.vehicleName is string && request.resource.data.vehicleName.size() <= 150
        && request.resource.data.downPayment is number && request.resource.data.downPayment >= 0
        && request.resource.data.termMonths is number && request.resource.data.termMonths > 0
        && request.resource.data.monthlyPayment is number && request.resource.data.monthlyPayment >= 0
        && request.resource.data.createdAt is timestamp
        && (!('vehiclePrice' in request.resource.data)
            || (request.resource.data.vehiclePrice is number
                && request.resource.data.vehiclePrice >= 0
                && request.resource.data.vehiclePrice <= 1000000000))
        && (!('downPaymentPct' in request.resource.data)
            || (request.resource.data.downPaymentPct is number
                && request.resource.data.downPaymentPct >= 0
                && request.resource.data.downPaymentPct <= 100))
        && (!('institution' in request.resource.data)
            || (request.resource.data.institution is string
                && request.resource.data.institution.size() <= 60))
        && (!('annualRate' in request.resource.data)
            || (request.resource.data.annualRate is number
                && request.resource.data.annualRate >= 0
                && request.resource.data.annualRate <= 100))
        && (!('vehicleType' in request.resource.data)
            || (request.resource.data.vehicleType is string
                && request.resource.data.vehicleType.size() <= 20));
      allow update: if false;
    }

    // Preferencias de búsqueda: documento único users/{uid}/preferences/settings.
    // Mismo fallo que en favoritos: la lectura caía bajo una condición que
    // desreferencia request.resource.data y quedaba denegada, así que las
    // preferencias guardadas no se recuperaban nunca. Aquí ni siquiera
    // había la vía de escape de `request.method == 'delete'`.
    match /users/{uid}/preferences/{docId} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow delete: if signedIn() && request.auth.uid == uid;

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'brands', 'priceMin', 'priceMax', 'vehicleType', 'transmission', 'fuel'
        ])
        && (!('brands' in request.resource.data) || (request.resource.data.brands is list && request.resource.data.brands.size() <= 20))
        && (!('priceMin' in request.resource.data) || request.resource.data.priceMin is number)
        && (!('priceMax' in request.resource.data) || request.resource.data.priceMax is number)
        && (!('vehicleType' in request.resource.data) || (request.resource.data.vehicleType is string && request.resource.data.vehicleType.size() <= 30))
        && (!('transmission' in request.resource.data) || (request.resource.data.transmission is string && request.resource.data.transmission.size() <= 30))
        && (!('fuel' in request.resource.data) || (request.resource.data.fuel is string && request.resource.data.fuel.size() <= 30));
    }

    // ==========================================================
    // CONFIGURACIÓN PÚBLICA — config/finanzas
    // ----------------------------------------------------------
    // ⚠️ ESTA REGLA YA NO TIENE CONSUMIDOR (verificado). Se añadió porque
    // app.js leía config/finanzas al arrancar para obtener la tasa USD->RD$
    // y, sin regla propia, esa lectura caía en el deny por defecto
    // (permission-denied, HTTP 403 comprobado contra el proyecto real).
    // Después, A-1 eliminó la lectura junto con la conversión de moneda: hoy
    // `grep tasaUsdRd` no encuentra ningún uso en código vivo, y el
    // documento nunca llegó a existir en producción.
    //
    // SE CONSERVA a propósito, no por olvido:
    //   - No amplía la superficie de ataque de forma significativa. La
    //     lectura anónima solo alcanza a `config/finanzas`, y las reglas de
    //     escritura de abajo acotan ese documento a UN campo numérico entre
    //     0 y 1000 escribible solo por un admin: es imposible colocar ahí
    //     datos sensibles. Cualquier otro documento de /config queda
    //     denegado incluso en lectura (hay prueba de ello).
    //   - Retirarla costaría las ~20 pruebas de config de
    //     firestore_rules_test.js, una de las cuales es la regresión
    //     explícita de A-1, y habría que rehacerlo todo el día que se quiera
    //     una tasa configurable de verdad (con valor, fecha y fuente, como
    //     exige el README).
    // Si se decide retirarla, hay que borrar también esas pruebas.
    //
    // Decisiones de esta regla:
    //   - Acotada a docId == 'finanzas', también en LECTURA. Es el único
    //     documento que la aplicación usa. Así, si algún día se crea otro
    //     documento en /config con datos internos, cae en el deny por
    //     defecto en vez de quedar público por accidente.
    //   - hasOnly(['tasaUsdRd']): el único campo que la aplicación lee
    //     (app.js -> USD_TO_RD_RATE). Cierra la puerta a campos inesperados.
    //   - tasaUsdRd > 0, no >= 0: una tasa de 0 convertiría a RD$ 0 todo
    //     precio publicado en dólares, que es tan inválido como un negativo.
    //   - Sin `delete`: borrar el documento devolvería la tasa al respaldo
    //     del código en silencio. Si hay que corregirla, se sobrescribe.
    // ==========================================================
    match /config/{docId} {
      allow read: if docId == 'finanzas';

      allow create, update:
        if isAdmin()
        && docId == 'finanzas'
        && request.resource.data.keys().hasOnly(['tasaUsdRd'])
        && 'tasaUsdRd' in request.resource.data
        && request.resource.data.tasaUsdRd is number
        && request.resource.data.tasaUsdRd > 0
        && request.resource.data.tasaUsdRd <= 1000;

      allow delete: if false;
    }

    // Deny por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
